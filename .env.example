# Optional overrides for the demo administrator sign-in.
# These values are bundled into the browser build, so treat them as demo-only.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# Supabase (optional). Only VITE_-prefixed values reach the browser; the anon key is
# public by design and row-level security is what protects real student data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
